# Export these variables in the shell or configure them in the deployment environment.
# Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=development
HOTEL_DB_URL=jdbc:postgresql://127.0.0.1:5433/hotel_db
HOTEL_DB_USER=hotel_admin
HOTEL_DB_PASSWORD=
# Enable on a fresh database or after explicitly baselining a verified legacy database.
HOTEL_FLYWAY_ENABLED=false
HOTEL_JWT_SECRET=
HOTEL_PUBLIC_BASE_URL=http://localhost:8080
HOTEL_FRONTEND_BASE_URL=http://localhost:5173
HOTEL_GOOGLE_CLIENT_ID=
HOTEL_SMTP_HOST=smtp.gmail.com
HOTEL_SMTP_PORT=587
HOTEL_SMTP_USER=
HOTEL_SMTP_PASSWORD=
# Compose host port for the selected PostgreSQL stack.
HOTEL_DB_HOST_PORT=5433
