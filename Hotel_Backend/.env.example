# Export these variables in the shell or configure them in the deployment environment.
# Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=development
HOTEL_DB_URL=jdbc:postgresql://127.0.0.1:5433/hotel_db
HOTEL_DB_USER=hotel_admin
HOTEL_DB_PASSWORD=
# Enable on a fresh database or after explicitly baselining a verified legacy database.
HOTEL_FLYWAY_ENABLED=false
# Enable after V11 and verification of any account links required by existing users.
HOTEL_CANONICAL_BOOKING_ENABLED=false
# Keep true until every Basic user has a verified link (see docs/backend_review_2026-11-23.md, #12).
HOTEL_BASIC_AUTH_ENABLED=true
# operational (default): start-up requires every Payment and Checkout table and V12, also with Flyway off.
# report-only: reports-only database; set by SPRING_PROFILES_ACTIVE=report-demo, refused with canonical booking.
# HOTEL_SCHEMA_MODE=
# E-mail outbox worker. Requires V12 and V13; delivery is at-least-once. Queue times use PostgreSQL time.
HOTEL_NOTIFICATIONS_ENABLED=true
# Claims per message (render error, SMTP error or lost lease each count); then FAILED.
HOTEL_NOTIFICATIONS_MAX_ATTEMPTS=5
# Outbox lease per message; must exceed the three SMTP timeouts together.
HOTEL_NOTIFICATIONS_LEASE_SECONDS=300
# Simulated MOCK_QR/MOCK_CARD writes: true by default, false under SPRING_PROFILES_ACTIVE=production.
# Leave unset so the profile decides; setting it overrides the production default.
# HOTEL_PAYMENT_MOCK_ENABLED=
# Longest stay for canonical search and hold (technical default, no business limit specified).
HOTEL_BOOKING_MAX_NIGHTS=90
HOTEL_JWT_SECRET=
HOTEL_PUBLIC_BASE_URL=http://localhost:8080
HOTEL_FRONTEND_BASE_URL=http://localhost:5173
HOTEL_GOOGLE_CLIENT_ID=
HOTEL_SMTP_HOST=smtp.gmail.com
HOTEL_SMTP_PORT=587
HOTEL_SMTP_USER=
HOTEL_SMTP_PASSWORD=
HOTEL_SMTP_CONNECT_TIMEOUT_MS=10000
HOTEL_SMTP_READ_TIMEOUT_MS=10000
HOTEL_SMTP_WRITE_TIMEOUT_MS=10000
# Compose host port for the selected PostgreSQL stack.
HOTEL_DB_HOST_PORT=5433
